# ==========================================
# SmartCompress AI - .gitignore
# Information Storage Management (ISM) Project
# ==========================================

# ------------------------------------------
# Byte-compiled / Python caches & DLLs
# ------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyd
*.pyo

# C / C++ / Rust extensions
*.so
*.dylib
*.dll

# ------------------------------------------
# Distribution & Packaging
# ------------------------------------------
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ------------------------------------------
# Virtual Environments
# ------------------------------------------
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# ------------------------------------------
# Environment Variables & Secrets
# ------------------------------------------
.env
.env.local
.env.*.local
!.env.example

# ------------------------------------------
# Temporary User Uploads & Generated Outputs
# ------------------------------------------
uploads/*
!uploads/.gitkeep
compressed/*
!compressed/.gitkeep
reports/*
!reports/.gitkeep

# ------------------------------------------
# SQLite Databases & Local State
# ------------------------------------------
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
*.sqlitedb
database/*.db
database/*.sqlite*
database/*.db-wal
database/*.db-shm
database/*.db-journal
database/database.db
database/test_database.db
database/test_database.db*

# ------------------------------------------
# Testing, Pytest & Coverage
# ------------------------------------------
.pytest_cache/
.coverage
.coverage.*
coverage.xml
*.cover
htmlcov/
.hypothesis/
.tox/
.nox/
tests/test_uploads/
tests/test_compressed/
tests/test_reports/
tests/test_database.db*

# ------------------------------------------
# Linters, Type Checkers & Tool Caches
# ------------------------------------------
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/
.cache/

# ------------------------------------------
# OS Generated Files
# ------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Thumbs.db:encryptable
desktop.ini
$RECYCLE.BIN/

# ------------------------------------------
# IDE & Code Editor Files
# ------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
*.bak
*.tmp
*.sublime-project
*.sublime-workspace
.project
.pydevproject
.settings/

# ------------------------------------------
# Logs & Process Outputs
# ------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
